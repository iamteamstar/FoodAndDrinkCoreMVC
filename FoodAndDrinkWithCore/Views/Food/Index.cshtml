@using X.PagedList;
@using X.PagedList.Mvc.Core;

@model IPagedList<FoodAndDrinkWithCore.Data.Models.Food>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 style="margin-bottom:10px">Food List</h2>

<table class="table table-bordered">
    <tr>
        <th>Food ID</th>
        <th>Food Name</th>
        <th>Food Price</th>
        <th>Food Stock</th>
        <th>Category Name</th>
        <th>Delete</th>
        <th>Update</th>
        <th>Details</th>
    </tr>
    @foreach(var x in Model)
    {
        <tr>
            <th>@x.FoodID</th>
            <td>@x.FoodName</td>
            <td>@x.FoodPrice</td>
            <td>@x.FoodStock</td>
            <td>@x.Category.CategoryName</td>
            <td><a href="/Food/FoodRemove/@x.FoodID" class="btn btn-danger">Delete</a></td>
            <td><a href="/Food/FoodFind/@x.FoodID" class="btn btn-info">Update</a></td>
            <td><a class="btn btn-primary">Details</a></td>
        </tr>
    }
</table>
@Html.PagedListPager((IPagedList)Model,page=>Url.Action("Index",new {page}))
<a href="/Food/FoodAdd" class="btn btn-success">New Food</a>