@model FoodAndDrinkWithCore.Data.Models.Food
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using(Html.BeginForm("FoodUpdate","Food",FormMethod.Post))
{
    @Html.Label("Food Id")
    @Html.TextBoxFor(x=>x.FoodID,new {@class="form-control"})
    @Html.Label("Food Name")
    @Html.TextBoxFor(x => x.FoodName, new { @class = "form-control" })
    @Html.Label("Food Price")
    @Html.TextBoxFor(x => x.FoodPrice, new { @class = "form-control" })
    @Html.Label("Food Stock")
    @Html.TextBoxFor(x => x.FoodStock, new { @class = "form-control" })
    @Html.Label("Category ID")
    @Html.DropDownListFor(x => x.CategoryID,(List <SelectListItem>)ViewBag.val, new { @class = "form-control" })
    @Html.Label("Food Image")
    @Html.TextBoxFor(x => x.FoodImageUrl, new { @class = "form-control" })
    @* @Html.TextBoxFor(x => x.CategoryID, new { @class = "form-control" }) *@
    @Html.Label("Food Description")
    @Html.TextBoxFor(x => x.FoodDesc, new { @class = "form-control" })
    <br />
    <button class="btn btn-success">Update Food</button>
}
