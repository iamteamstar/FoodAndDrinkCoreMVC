@model FoodAndDrinkWithCore.Data.Models.Category
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using(Html.BeginForm("CategoryUpdate","Category",FormMethod.Post))
{
    @Html.Label("Category ID")
    @Html.TextBoxFor(x => x.CategoryID, new { @class = "form-control" })
    <br />
    @Html.Label("Category Name")
    @Html.TextBoxFor(x => x.CategoryName,new {@class="form-control"})
    <br />
    @Html.Label("Category Description")
    @Html.TextBoxFor(x => x.CategoryDesc, new { @class = "form-control" })
    <br />
    @Html.Label("Category Status")
    @Html.TextBoxFor(x => x.status, new { @class = "form-control" })
    <br />
    <button class="btn btn-warning">Update</button>
}