@{
    ViewData["Title"] = "Index3";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Result Visualization</title>
    <script type="text/javascript" src="https://www.google.com/jsapi"></script>
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script src="http://ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>
    <script type="text/javascript">
        // 1. Önce Google Charts kütüphanesini yüklüyoruz
        google.charts.load('current', { 'packages': ['corechart'] });

        // 2. Kütüphane yüklendiğinde AJAX fonksiyonunu çalıştırıyoruz
        google.charts.setOnLoadCallback(LoadData);

        function LoadData() {
            $.ajax({
                type: "POST",
                dataType: "json",
                contentType: "application/json",
                url: '@Url.Action("VisualizeProductResult2", "Chart")',
                success: function (result) {
                    drawChart(result);
                },
                error: function () {
                    alert("Veriler yüklenirken bir hata oluştu!");
                }
            });
        }

        function drawChart(result) {
            var data = new google.visualization.DataTable();
            data.addColumn('string', 'Name');
            data.addColumn('number', 'Stoklar');

            var dataArray = [];
            $.each(result, function (i, obj) {
                dataArray.push([obj.foodName, obj.foodStock]); // Not: JSON'da küçük harf başlayabilir
            });
            data.addRows(dataArray);

            var options = {
                title: "Food - Stock Chart",
                width: 1000,
                height: 750,
                is3D: true // PieChart için güzel bir özellik
            };

            var chart = new google.visualization.PieChart(document.getElementById('Piechart_div'));
            chart.draw(data, options);
        }
    </script>
</head>
<body>
    <div id="Piechart_div"></div>
</body>
</html>
